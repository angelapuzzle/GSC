# ==============================================================================
# MAVEN & COMPILACIÓN
# ==============================================================================
# Carpeta de salida donde Maven coloca los .class y el archivo .jar generado
target/

# Archivos temporales o de log creados por Maven
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.nextVersionsBackup
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.attributes

# Evitamos subir el JAR o WAR empaquetado directamente
*.jar
*.war
*.ear
*.rar

# ==============================================================================
# ENTORNO DE DESARROLLO (IDEs)
# ==============================================================================

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/
.idea_modules/

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# ==============================================================================
# DOCKER & SISTEMA OPERATIVO / TEMPORALES
# ==============================================================================
# Archivos de datos o volúmenes locales persistidos de Postgres/Docker
.docker/
postgres-data/

# Archivos del sistema operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs de ejecución locales
*.log
logs/

# ==============================================================================
# EXCEPCIONES (Archivos que SÍ deben ir en el repositorio)
# ==============================================================================
# Permitimos la inclusión del wrapper de Maven para poder compilar sin Maven instalado
!.mvn/wrapper/maven-wrapper.jar
!mvnw
!mvnw.cmd